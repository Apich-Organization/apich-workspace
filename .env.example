# ==============================================================================
# APICH Workspace - Environment Configuration Example
# Copy to .env and adjust as needed: cp .env.example .env
# ==============================================================================

# Web Server Listening Port
PORT=8080

# Public Base URL (used for redirects, invite links, OAuth callbacks, and default WebAuthn RP origin)
BASE_URL=http://localhost:8080

# WebAuthn / FIDO2 Passkey Relying Party Configuration
# Optional: By default, RP_ID and RP_ORIGIN are automatically derived from BASE_URL.
# For production multi-subdomain passkeys or custom origins, uncomment and set explicitly:
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_RP_ORIGIN=https://workspace.apich.org
# WEBAUTHN_RP_NAME="APICH Workspace"

# JWT Signing Secret Key (change in production!)
JWT_SECRET=apich_development_secret_key_change_in_production

# Host Filesystem Storage Root for Workspace Files
APICH_STORAGE_DIR=./scratch/workspace

# PostgreSQL Database Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=apich_workspace

# Container Sandbox Configuration
APICH_SANDBOX_IMAGE=apich-sandbox:latest
APICH_SANDBOX_IDLE_TIMEOUT_MINUTES=60
APICH_SANDBOX_REMOVAL_GRACE_HOURS=24

# AI Model Provider Keys (Optional)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...

# SMTP Email Configuration (Optional Environment Overrides)
# Note: Primary SMTP settings are configured and stored via Admin UI (/admin/platform).
# SMTP_FORCE_TLS=true allows forcing direct TLS wrapper (SMTPS, port 465) via environment.
SMTP_FORCE_TLS=true

# Rust Logging Level
RUST_LOG=info,apich_web=debug,apich_db=info,apich_sandbox=info

