# ==============================================================================
# APICH Next-Gen Technical & Academic Workspace Sandbox Image
# Includes: Rust toolchain, Python3 scientific stack, Git, R, LaTeX (XeTeX/latexmk), Typst,
# and CLI coding-agent tools (opencode, aider, goose, claude-code, codex) so a user can point
# an agent directly at their real project files inside the container, per plan.md -- this is
# not a chat-only assistant, the agent gets a real shell in the real workspace.
#
# NOTE on "google antigravity": plan.md also names this alongside the other agent CLIs, but
# as of this image's authorship there is no publicly documented, installable CLI package under
# that name that could be verified here -- so it is deliberately left out rather than guessed
# at with a fabricated install command. Add it once a real package/binary exists to point to.
# ==============================================================================

FROM debian:trixie-slim

LABEL maintainer="APICH Team"
LABEL description="Full-stack scientific, engineering and academic compilation sandbox"

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/home/apich/.cargo/bin:$PATH

# 1. Install base utilities, C/C++ build tools, Git, Python, R, and LaTeX
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    gnupg \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    libasound2-dev \
    libx11-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    libwayland-dev \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    r-base \
    r-base-dev \
    r-cran-dbi \
    r-cran-rsqlite \
    r-cran-ggplot2 \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-xetex \
    texlive-luatex \
    texlive-fonts-recommended \
    latexmk \
    lmodern \
    xz-utils \
    jq \
    sqlite3 \
    procps \
    sudo \
    nodejs \
    npm \
    pipx \
    && rm -rf /var/lib/apt/lists/*

# 1b. Python's real "scientific stack" -- the label in this file's own header comment was
# previously aspirational: bare `python3`/`pip` alone has none of pandas/numpy/matplotlib
# installed, so the table notebook feature (Python/R cells reading a project's SQLite tables via
# `sqlite3`/`pandas.read_sql_query`, see `crates/apich-web/src/services/sqlite_table.rs`'s
# `NotebookCell`) would fail on the very first `import pandas` otherwise. `--break-system-packages`
# matches this file's own existing convention for pip on Debian's PEP-668-managed system Python
# (see the `aider-chat` install below). `MPLBACKEND=Agg` (set globally via ENV, not per-invocation)
# is required for matplotlib to save a plot to a file at all in a container with no display server
# -- its default backend otherwise errors immediately trying to open a GUI window.
RUN pip3 install --break-system-packages --no-cache-dir pandas numpy matplotlib
ENV MPLBACKEND=Agg

# 2. Install Rust toolchain (system-wide accessible)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal \
    && chmod -R a+w /usr/local/cargo /usr/local/rustup \
    && rustc --version && cargo --version

# 3. Install Typst CLI (latest binary release)
ARG TYPST_VERSION=v0.13.0
RUN set -eux; \
    ARCH="$(uname -m)"; \
    if [ "$ARCH" = "x86_64" ]; then \
        TYPST_ARCH="x86_64-unknown-linux-musl"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        TYPST_ARCH="aarch64-unknown-linux-musl"; \
    else \
        TYPST_ARCH="x86_64-unknown-linux-musl"; \
    fi; \
    TAR_URL="https://github.com/typst/typst/releases/download/${TYPST_VERSION}/typst-${TYPST_ARCH}.tar.xz"; \
    curl -fsSL "$TAR_URL" -o /tmp/typst.tar.xz \
    || curl -fsSL "https://github.com/typst/typst/releases/latest/download/typst-${TYPST_ARCH}.tar.xz" -o /tmp/typst.tar.xz; \
    tar -xf /tmp/typst.tar.xz -C /tmp; \
    cp /tmp/typst-*/typst /usr/local/bin/typst; \
    chmod +x /usr/local/bin/typst; \
    rm -rf /tmp/typst* \
    && typst --version

# 4. Install cargo-slide (presentation build tool -- `cargo slide build` packages a Typst-authored
# deck into a standalone native binary), from a vendored copy at /vendor/cargo-slide (see that
# directory's own note) rather than a fresh git clone of upstream, because it carries a small,
# deliberate patch: upstream's `build` subcommand has no `--target <triple>` flag at all, so
# there was previously no way to ask it for anything but the host's own platform. The patch adds
# that flag (plumbed through to the inner `cargo build --target`) and fixes a real bug it exposed
# -- the output binary's `.exe` extension was decided by `cfg!(windows)`, i.e. whether upstream's
# own build *host* is Windows, which is never true here and so silently produced a Windows binary
# with no `.exe` extension whenever cross-compiling to a Windows target.
#
# Kept at /opt/cargo-slide-src (not deleted after `cargo install`, unlike upstream's own approach)
# because `cargo slide build` resolves its `slide-core`/`slide-player` path dependencies by
# searching upward from `$CARGO_SLIDE_REPO_ROOT` (see crates/cargo-slide/src/commands/build.rs's
# `find_repo_root`) -- that env var, set below, points at this same on-disk copy so every build
# resolves those dependencies from a known-good local source instead of depending on whatever (if
# anything) happens to be published on crates.io under a matching version.
COPY vendor/cargo-slide /opt/cargo-slide-src
# `cargo install` builds inside the workspace's own `target/release/` (same as a plain `cargo
# build`) and only *copies* the finished binary to $CARGO_HOME/bin afterward -- it never cleans
# that build directory up. Since `cargo slide build` writes runtime output to a completely
# separate path (`target/standalone_target`, via `CARGO_SLIDE_REPO_ROOT`, never `target/release`),
# none of it is ever reused: confirmed live, it was sitting at 611 MB of compiled release-mode
# dependency .rlib/.rmeta files (rav1e's AV1 encoder, resvg, several image codecs, symphonia's
# audio decoders, ...) against 720 KB of actual source, pure dead weight baked into every image.
RUN cargo install --path /opt/cargo-slide-src/crates/cargo-slide --locked \
    && cargo slide --version \
    && rm -rf /opt/cargo-slide-src/target
ENV CARGO_SLIDE_REPO_ROOT=/opt/cargo-slide-src

# 4b. Cross-compilation for `cargo slide build --target <triple>` -- four targets, matching what
# a presentation might realistically be handed out for: Windows and Linux, each on x86_64 and
# aarch64, with the two Linux targets built against musl (fully static, no glibc-version-matching
# concerns for whoever the binary is handed to). Every one of these four was validated end-to-end
# against slide-player's real dependency graph (rodio/cpal/alsa on Linux, minifb, resvg, rusqlite
# with the `bundled` C amalgamation) before being added here, not assumed to "probably work":
#
# - x86_64-unknown-linux-musl: Debian's own `musl-tools` package (musl-gcc) is enough for the
#   Rust/C side, but ALSA (`alsa-sys`, pulled in by `cpal`) needs a *musl*-linked libasound --
#   Debian's `libasound2-dev` is glibc-only and can't be dynamically linked into a musl binary --
#   so a static libasound is built from source below and pointed to via a target-scoped
#   PKG_CONFIG_PATH (see the `pkg-config` crate's own `PKG_CONFIG_PATH_<target>` convention,
#   which lets this be set globally here without affecting the host's own native builds at all).
# - aarch64-unknown-linux-musl: same shape, using a prebuilt musl.cc cross toolchain (Debian has
#   no aarch64-musl cross-gcc package) as the C compiler for both musl-libc itself and the static
#   libasound build.
# - x86_64-pc-windows-gnu and aarch64-pc-windows-gnullvm: both via a single llvm-mingw toolchain
#   (clang+lld-based, unlike classic mingw-w64/binutils) -- picked specifically because it's the
#   only realistic way to target Windows-on-Arm64 from Linux without Microsoft's own MSVC SDK;
#   using the same toolchain family for the x86_64 Windows target too avoids maintaining two
#   different Windows cross-compilation setups side by side. Windows needs none of the ALSA
#   complexity above: `cpal`'s Windows backend talks to WASAPI directly through the `windows`/
#   `winapi` crates, with no external C library to link.
# - aarch64-unknown-linux-gnu: the ARM Linux counterpart to the host's own native x86_64 build,
#   and the ONLY way to give ARM Linux users a presentation that actually opens a window. The
#   musl ARM target above cannot: Rust's musl targets are fully static (`crt-static` on by
#   default), and `minifb` loads its X11/Wayland backend through `dlopen()` at runtime, which a
#   static binary has no dynamic linker to service -- musl's own stub returns "Dynamic loading
#   not supported" unconditionally, on every machine. So ARM Linux needs a *glibc* target, which
#   means a real arm64 sysroot: Debian multiarch (`dpkg --add-architecture arm64`) for the
#   libasound `alsa-sys` links against, plus `gcc-aarch64-linux-gnu` as the linker. X11 dev
#   packages are deliberately NOT needed here -- minifb dlopens those at runtime rather than
#   linking them, so only ALSA has to exist at build time.
RUN rustup target add \
    x86_64-unknown-linux-musl \
    aarch64-unknown-linux-musl \
    aarch64-unknown-linux-gnu \
    x86_64-pc-windows-gnu \
    aarch64-pc-windows-gnullvm

# arm64 glibc cross toolchain + the arm64 ALSA headers/libs `alsa-sys` needs at build time.
RUN dpkg --add-architecture arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc-aarch64-linux-gnu \
        libasound2-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

# Kernel UAPI headers (<linux/*.h>, <asm/*.h>) that musl-gcc's own sysroot doesn't ship, but
# alsa-lib's build needs -- copied in from glibc's `linux-libc-dev` package, safe to share since
# they're pure kernel-ABI struct definitions with no glibc-specific content.
RUN apt-get update && apt-get install -y --no-install-recommends musl-tools musl-dev linux-libc-dev \
    && rm -rf /var/lib/apt/lists/* \
    && MUSL_INC=/usr/include/x86_64-linux-musl \
    && for d in linux asm-generic mtd rdma scsi sound drm video xen misc; do \
        if [ -d "/usr/include/$d" ] && [ ! -e "$MUSL_INC/$d" ]; then cp -r "/usr/include/$d" "$MUSL_INC/$d"; fi; \
    done \
    && cp -r /usr/include/x86_64-linux-gnu/asm "$MUSL_INC/asm"

ARG ALSA_VERSION=1.2.12
RUN set -eux; \
    cd /tmp; \
    curl -fsSL -o alsa-lib.tar.bz2 "https://www.alsa-project.org/files/pub/lib/alsa-lib-${ALSA_VERSION}.tar.bz2"; \
    tar xjf alsa-lib.tar.bz2; \
    cd "alsa-lib-${ALSA_VERSION}"; \
    CC=musl-gcc ./configure --host=x86_64-linux-musl --prefix=/opt/alsa-musl-x86_64 --enable-static --disable-shared --disable-python; \
    make -j"$(nproc)"; \
    make install; \
    cd /tmp && rm -rf "alsa-lib-${ALSA_VERSION}" alsa-lib.tar.bz2

# aarch64-linux-musl cross toolchain (musl.cc's prebuilt gcc), used both to compile Rust's own C
# dependencies for that target and, immediately below, to build the aarch64 static libasound.
ARG AARCH64_MUSL_CROSS_URL=https://musl.cc/aarch64-linux-musl-cross.tgz
RUN curl -fsSL -o /tmp/aarch64-cross.tgz "${AARCH64_MUSL_CROSS_URL}" \
    && tar xzf /tmp/aarch64-cross.tgz -C /opt \
    && rm /tmp/aarch64-cross.tgz
ENV PATH=/opt/aarch64-linux-musl-cross/bin:$PATH
RUN set -eux; \
    MUSL_INC=/opt/aarch64-linux-musl-cross/aarch64-linux-musl/include; \
    for d in linux asm-generic mtd rdma scsi sound drm video xen misc; do \
        if [ -d "/usr/include/$d" ] && [ ! -e "$MUSL_INC/$d" ]; then cp -r "/usr/include/$d" "$MUSL_INC/$d"; fi; \
    done; \
    if [ ! -e "$MUSL_INC/asm" ] && [ -d /usr/include/aarch64-linux-gnu/asm ]; then cp -r /usr/include/aarch64-linux-gnu/asm "$MUSL_INC/asm"; fi; \
    if [ ! -e "$MUSL_INC/asm" ]; then cp -r /usr/include/x86_64-linux-gnu/asm "$MUSL_INC/asm"; fi
RUN set -eux; \
    cd /tmp; \
    curl -fsSL -o alsa-lib.tar.bz2 "https://www.alsa-project.org/files/pub/lib/alsa-lib-${ALSA_VERSION}.tar.bz2"; \
    tar xjf alsa-lib.tar.bz2; \
    cd "alsa-lib-${ALSA_VERSION}"; \
    CC=aarch64-linux-musl-gcc ./configure --host=aarch64-linux-musl --prefix=/opt/alsa-musl-aarch64 --enable-static --disable-shared --disable-python; \
    make -j"$(nproc)"; \
    make install; \
    cd /tmp && rm -rf "alsa-lib-${ALSA_VERSION}" alsa-lib.tar.bz2

# llvm-mingw: one clang+lld-based toolchain covering both Windows cross targets (see the note
# above on why aarch64-pc-windows-gnullvm specifically needs this rather than classic mingw-w64).
ARG LLVM_MINGW_VERSION=20250910
RUN set -eux; \
    ARCH="$(uname -m)"; \
    curl -fsSL -o /tmp/llvm-mingw.tar.xz "https://github.com/mstorsjo/llvm-mingw/releases/download/${LLVM_MINGW_VERSION}/llvm-mingw-${LLVM_MINGW_VERSION}-ucrt-ubuntu-22.04-${ARCH}.tar.xz"; \
    tar xf /tmp/llvm-mingw.tar.xz -C /opt; \
    mv /opt/llvm-mingw-* /opt/llvm-mingw; \
    rm /tmp/llvm-mingw.tar.xz
ENV PATH=/opt/llvm-mingw/bin:$PATH

RUN mkdir -p /usr/local/cargo && { \
    echo '[target.x86_64-unknown-linux-musl]'; \
    echo 'linker = "musl-gcc"'; \
    echo; \
    echo '[target.aarch64-unknown-linux-musl]'; \
    echo 'linker = "aarch64-linux-musl-gcc"'; \
    echo; \
    echo '[target.aarch64-unknown-linux-gnu]'; \
    echo 'linker = "aarch64-linux-gnu-gcc"'; \
    echo; \
    echo '[target.x86_64-pc-windows-gnu]'; \
    echo 'linker = "x86_64-w64-mingw32-clang"'; \
    echo 'ar = "llvm-ar"'; \
    echo; \
    echo '[target.aarch64-pc-windows-gnullvm]'; \
    echo 'linker = "aarch64-w64-mingw32-clang"'; \
    echo 'ar = "llvm-ar"'; \
    } > /usr/local/cargo/config.toml

# `pkg-config`-rs (used by `alsa-sys`) checks a target-scoped env var before the plain
# PKG_CONFIG_PATH -- setting only the scoped names here means this has zero effect on native
# host builds (e.g. this same image's own `cargo install` steps), only on an explicit
# `--target x86_64/aarch64-unknown-linux-musl` build.
ENV PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_PATH_x86_64_unknown_linux_musl=/opt/alsa-musl-x86_64/lib/pkgconfig \
    PKG_CONFIG_PATH_aarch64_unknown_linux_musl=/opt/alsa-musl-aarch64/lib/pkgconfig \
    PKG_CONFIG_PATH_aarch64_unknown_linux_gnu=/usr/lib/aarch64-linux-gnu/pkgconfig

# 5. Install CLI coding agents. Each is wrapped so one broken install doesn't fail the whole
#    image build; `/usr/local/bin/apich-agent-status` (written below) reports what actually made
#    it in, so apich-sandbox's Rust side can check real availability instead of assuming.
RUN npm install -g @anthropic-ai/claude-code || echo "apich-agent-install-failed: claude-code"
RUN npm install -g @openai/codex || echo "apich-agent-install-failed: codex"
RUN npm install -g opencode-ai || echo "apich-agent-install-failed: opencode"
# aider-chat on this Debian 13 (trixie) base: every published aider-chat release through 0.86.2
# declares `Requires-Python <3.13`, and trixie ships Python 3.13 as its *only* system Python (no
# 3.11/3.12 package in its repos) -- confirmed live via `pipx install aider-chat` itself (pip
# resolves down to the ancient, yanked-adjacent aider-chat 0.16.0, whose hard `numpy==1.24.3` pin
# then fails to build under 3.13 because numpy's legacy build backend needs distutils, removed in
# 3.12+). `pipx install --python 3.11/3.12 --fetch-missing-python` (which downloads a standalone
# interpreter for exactly this situation) was also confirmed live to fail here: pipx 1.7.1 404s
# fetching the checksum for the python-build-standalone release it just downloaded.
#
# Fix: `uv` (astral.sh) manages its own python-build-standalone downloads independently of pipx
# and was confirmed live to fetch Python 3.12.14 cleanly with the exact same underlying release
# files pipx failed on -- aider-chat then resolves against a modern, unpinned dependency set (real
# numpy/scipy wheels for 3.12, not the ancient 1.24.3 sdist) and installs and runs correctly.
# `UV_PYTHON_INSTALL_DIR`/`UV_TOOL_DIR`/`UV_TOOL_BIN_DIR` redirect uv's normally-per-user (~/.local)
# install locations to shared `/opt` dirs + `/usr/local/bin`, matching how `goose` below is made
# available to every user rather than just whichever account ran the installer.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_TOOL_DIR=/opt/uv-tools \
    UV_TOOL_BIN_DIR=/usr/local/bin
RUN curl -LsSf https://astral.sh/uv/install.sh -o /tmp/uv-install.sh \
    && UV_INSTALL_DIR=/usr/local/bin sh /tmp/uv-install.sh \
    && rm /tmp/uv-install.sh \
    && uv python install 3.12 \
    && uv tool install --python 3.12 aider-chat \
    && chmod -R a+rX /opt/uv-python /opt/uv-tools \
    || echo "apich-agent-install-failed: aider"
RUN curl -fsSL https://github.com/block/goose/releases/download/stable/download_cli.sh | CONFIGURE=false bash \
    && mv /root/.local/bin/goose /usr/local/bin/goose \
    || echo "apich-agent-install-failed: goose"
# Google Antigravity CLI (agy), the successor to Gemini CLI -- real installer, confirmed live on
# the dev qube (`agy --version` -> 1.1.27) before adding it here; previously left out of this
# image entirely because no verifiable install method could be found for it.
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash \
    && (command -v agy || mv "$HOME/.local/bin/agy" /usr/local/bin/agy) \
    || echo "apich-agent-install-failed: agy"

# agy's OAuth login step tries to auto-launch a browser via `xdg-open` (real Debian package,
# pulled in as a dependency of something else) -- live-verified via `ps aux` inside a running
# container: with no display/browser to actually open, `xdg-open` zombies and agy then stalls
# for well over 90 seconds instead of promptly printing the manual-paste-the-URL fallback it
# already supports. This container never has a real browser to launch regardless of who calls
# xdg-open, so replace it with an instant no-op -- standard practice for headless server images,
# not specific to agy.
RUN printf '#!/bin/sh\nexit 0\n' > /usr/bin/xdg-open && chmod +x /usr/bin/xdg-open

RUN { \
    echo '#!/bin/sh'; \
    echo 'for bin in claude codex opencode aider goose agy; do'; \
    echo '  if command -v "$bin" >/dev/null 2>&1; then echo "$bin: available"; else echo "$bin: missing"; fi'; \
    echo 'done'; \
    } > /usr/local/bin/apich-agent-status && chmod +x /usr/local/bin/apich-agent-status

# 6. Create non-root developer user (apich, UID 1000)
RUN useradd -m -u 1000 -s /bin/bash apich \
    && echo "apich ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    # `cargo install cargo-slide` (step 4) ran as root and populated
    # /usr/local/cargo/registry with new root-owned cache/index files *after* the one-time
    # `chmod -R a+w` in step 2 -- so without this, `cargo slide build`'s own dependency downloads
    # fail at runtime with a real "Permission denied" once the container drops to the apich user
    # below. Re-applying world-write here (not just to apich) matches step 2's own approach and
    # covers any other user a container might run as. `/opt/cargo-slide-src` needs the exact same
    # treatment and for the exact same reason -- confirmed live: `cargo slide build --target
    # x86_64-unknown-linux-musl` failed with "Permission denied" writing into
    # `/opt/cargo-slide-src/target/standalone_target` (that crate's own build output directory,
    # see `CARGO_SLIDE_REPO_ROOT` above) the first time it ran as `apich`, since step 4's `cargo
    # install` and `cargo slide --version` both ran as root and left that whole tree root-owned.
    && chmod -R a+w /usr/local/cargo /usr/local/rustup /opt/cargo-slide-src \
    && mkdir -p /workspace \
    && chown -R apich:apich /workspace

WORKDIR /workspace
USER apich

CMD ["sleep", "infinity"]
